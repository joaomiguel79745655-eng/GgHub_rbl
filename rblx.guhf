local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- =========================================================================
-- CONFIGURAÇÃO PRIVADA DO DONO (SISTEMA DE SEGURANÇA LOCAL)
-- =========================================================================
local donosDoScript = {
    ["4idudd"] = true,
    ["nadahavem"] = true
}

shared.GuHub_Usuarios = shared.GuHub_Usuarios or {}
local usernameAtual = string.lower(LocalPlayer.Name)
local eDono = donosDoScript[LocalPlayer.Name] or false

-- =========================================================================
-- CONTROLE DE TEMPO E VALIDAÇÃO (1 SEMANA)
-- =========================================================================
local deveBloquear = false
local motivoBloqueio = ""

if not eDono then
    if shared.GuHub_Usuarios[usernameAtual] == "excluido" or shared.GuHub_Usuarios[usernameAtual] == "banido" then
        deveBloquear = true
        motivoBloqueio = "❌ GuHub: Seu acesso foi bloqueado pelo Dono!"
    else
        if not shared.GuHub_Usuarios[usernameAtual] then
            shared.GuHub_Usuarios[usernameAtual] = os.time()
        end
        
        local tempoInicial = shared.GuHub_Usuarios[usernameAtual]
        local umaSemana = 7 * 24 * 60 * 60
        
        if os.time() > (tempoInicial + umaSemana) then
            deveBloquear = true
            motivoBloqueio = "❌ Renove o seu plano GuHub!"
        end
    end
end

-- Interface de Bloqueio (Tela Preta)
if deveBloquear then
    local ScreenGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
    local BlackFrame = Instance.new("Frame", ScreenGui)
    BlackFrame.Size = UDim2.new(1, 0, 1, 0)
    BlackFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    BlackFrame.Active = true
    
    local TextLabel = Instance.new("TextLabel", BlackFrame)
    TextLabel.Size = UDim2.new(1, 0, 1, 0)
    TextLabel.Text = motivoBloqueio
    TextLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
    TextLabel.TextSize = 25
    TextLabel.Font = Enum.Font.SourceSansBold
    return
end

-- =========================================================================
-- CARREGAMENTO DA INTERFACE VISUAL (FLUENT LIB) - LINK CORRIGIDO OFICIAL
-- =========================================================================
local sucessoFluent, Fluent = pcall(function()
    return loadstring(game:HttpGet("https://githubusercontent.com"))()
end)

if not sucessoFluent or not Fluent then
    warn("❌ GuHub: Erro crítico ao carregar a biblioteca de interface (Fluent).")
    return
end

local Window = Fluent:CreateWindow({
    Title = "GuHub 🚀",
    SubTitle = "by 4idudd & nadahavem",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = false, -- Desativado o desfoque para evitar queda de FPS no celular
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

-- Criar abas do menu
local Tab1 = Window:AddTab({ Title = "Painel Principal", Icon = "settings" })

-- Input para pegar o nome do jogador alvo
Tab1:AddInput("InputAlvo", {
    Title = "Nome do Jogador Alvo:",
    Default = "",
    Placeholder = "Digite o nick aqui...",
    Numeric = false,
    Finished = true,
    Callback = function(textoDigitado)
        local username = string.gsub(textoDigitado, "^%s*(.-)%s*$", "%1")
        if username == "" then return end
        
        local sucesso, userId = pcall(function() return Players:GetUserIdFromNameAsync(username) end)
        if sucesso then
            local palavras = {"batata123", "senhaSegura99", "banidoAmanha", "capivaraDoMal"}
            local senhaAleatoria = palavras[math.random(1, #palavras)] .. math.random(100, 999)
            
            Fluent:Notify({
                Title = "Alvo Encontrado: " .. username,
                Content = "ID do Usuário verificado no banco de dados.",
                Duration = 5
            })
        else
            Fluent:Notify({
                Title = "Erro",
                Content = "Jogador não encontrado ou inválido.",
                Duration = 5
            })
        end
    end
})

-- Loop de monitoramento em tempo real do banimento
task.spawn(function()
    while task.wait(5) do
        if not eDono and (shared.GuHub_Usuarios[usernameAtual] == "excluido" or shared.GuHub_Usuarios[usernameAtual] == "banido") then
            LocalPlayer:Kick("❌ Seu acesso ao GuHub foi revogado pelo Dono!")
        end
    end
end)

-- =========================================================================
-- PAINEL EXCLUSIVO ADMIN (Apenas para 4idudd e nadahavem)
-- =========================================================================
if eDono then
    local TabAdmin = Window:AddTab({ Title = "👑 Gerenciamento", Icon = "user" })
    
    local function criarBotoesPainel(jogador)
        if jogador == LocalPlayer or donosDoScript[jogador.Name] then return end
        
        local nomeAlvo = string.lower(jogador.Name)

        TabAdmin:AddButton({
            Title = "🗑️ Excluir Acesso: " .. jogador.Name,
            Callback = function()
                shared.GuHub_Usuarios[nomeAlvo] = "excluido"
                Fluent:Notify({
                    Title = "GuHub Admin",
                    Content = jogador.Name .. " foi Excluído (Tela Preta ativa).",
                    Duration = 3
                })
            end
        })
        
        TabAdmin:AddButton({
            Title = "🔄 Renovar/Liberar: " .. jogador.Name,
            Callback = function()
                shared.GuHub_Usuarios[nomeAlvo] = os.time()
                Fluent:Notify({
                    Title = "GuHub Admin",
                    Content = "Acesso de " .. jogador.Name .. " renovado por +7 dias!",
                    Duration = 3
                })
            end
        })
    end

    -- Cria botões para quem já está no servidor
    for _, jogador in ipairs(Players:GetPlayers()) do
        criarBotoesPainel(jogador)
    end

    -- Cria botões dinamicamente para quem entrar depois
    Players.PlayerAdded:Connect(criarBotoesPainel)
end

Window:SelectTab(1)
