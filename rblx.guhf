            local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- =========================================================================
-- CONFIGURAÇÃO DO BANCO DE DADOS PÚBLICO (KVESTOR API)
-- =========================================================================
local BANCO_ID = "guhub_datastore_v2_4idudd"
-- CORREÇÃO: Adicionada a porta :2052 necessária para a API Kvestor responder no Roblox
local API_URL = "https://implying.cc" .. BANCO_ID .. "/" 

local API_URL = "https://implying.cc" .. BANCO_ID .. "/" 

-- Função genérica para requisições HTTP (Adaptada nativamente para o Delta Executor)
local function enviarRequisicao(url, dados)
    local sucesso = pcall(function()
        local requestFunc = request or http_request or (syn and syn.request) or (fluxus and fluxus.request)
        if requestFunc then
            requestFunc({
                Url = url,
                Method = "POST",
                Headers = {["Content-Type"] = "text/plain"},
                Body = dados
            })
        end
    end)
    return sucesso
end

-- Função para checar o status de um jogador no banco
local function obterStatusJogador(username)
    local sucesso, resultado = pcall(function()
        return game:HttpGet(API_URL .. string.lower(username))
    end)
    if sucesso and resultado then
        return string.gsub(resultado, "^%s*(.-)%s*$", "%1") -- Limpa espaços
    end
    return "livre"
end

-- =========================================================================
-- SISTEMA DE EXPIRAÇÃO (1 SEMANA) E REGISTRO AUTOMÁTICO
-- =========================================================================
local statusAtual = obterStatusJogador(LocalPlayer.Name)

-- Se for um usuário novo (nunca entrou), registra a data atual como início
if statusAtual == "livre" or statusAtual == "" or statusAtual == "404: Not Found" then
    -- Donos e administradores têm imunidade e não registram data de expiração
    if LocalPlayer.Name ~= "4idudd" and LocalPlayer.Name ~= "nadahavem" then
        local timestampAtual = tostring(os.time())
        enviarRequisicao(API_URL .. string.lower(LocalPlayer.Name), "data:" .. timestampAtual)
        statusAtual = "data:" .. timestampAtual
    end
end

-- Verificação de Expiração ou Bloqueio
local deveBloquear = false
local motivoBloqueio = ""

if LocalPlayer.Name ~= "4idudd" and LocalPlayer.Name ~= "nadahavem" then
    if statusAtual == "excluido" or statusAtual == "banido" then
        deveBloquear = true
        motivoBloqueio = "❌ GuHub: Seu acesso foi bloqueado pelo Dono!"
    elseif string.find(statusAtual, "data:") then
        local timestampInicial = tonumber(string.sub(statusAtual, 6))
        if timestampInicial then
            local umaSemanaEmSegundos = 7 * 24 * 60 * 60
            -- Checa se o tempo atual passou de 1 semana (7 dias) desde o primeiro login
            if os.time() > (timestampInicial + umaSemanaEmSegundos) then
                deveBloquear = true
                motivoBloqueio = "❌ Renove o seu plano GuHub!"
            end
        end
    end
end

-- Aplicação da Tela Preta de Bloqueio
if deveBloquear then
    local ScreenGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
    local BlackFrame = Instance.new("Frame", ScreenGui)
    BlackFrame.Size = UDim2.new(1, 0, 1, 0)
    BlackFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    BlackFrame.Active = true
    BlackFrame.Selectable = true
    
    local TextLabel = Instance.new("TextLabel", BlackFrame)
    TextLabel.Size = UDim2.new(1, 0, 1, 0)
    TextLabel.Text = motivoBloqueio
    TextLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
    TextLabel.TextSize = 24
    TextLabel.Font = Enum.Font.SourceSansBold
    return -- Encerra a execução do script aqui para o usuário bloqueado
end

-- =========================================================================
-- INTERFACE INTERNA DO JOGO (ORION LIB CONFIGURADA)
-- =========================================================================
-- CORREÇÃO: Aplicado um link funcional e estável da OrionLib compatível com Delta
local OrionLib = loadstring(game:HttpGet('https://githubusercontent.com'))()
local palavrasEngracadas = {"batata123", "senhaSegura99", "banidoAmanha", "capivaraDoMal"}

local Window = OrionLib:MakeWindow({Name = "GuHub 🚀", HidePremium = false, SaveConfig = false, IntroText = "Carregando GuHub..."})

local Tab = Window:MakeTab({Name = "Painel Hack", Icon = "rbxassetid://4483345998", PremiumOnly = false})
Tab:AddInput({
    Name = "Nome do Jogador:",
    Default = "",
    TextDisappear = false,
    Callback = function(textoDigitado)
        local username = string.gsub(textoDigitado, "^%s*(.-)%s*$", "%1")
        if username == "" then return end
        local sucesso, userId = pcall(function() return Players:GetUserIdFromNameAsync(username) end)
        if sucesso then
            local fotoUrl = Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
            local senhaAleatoria = palavrasEngracadas[math.random(1, #palavrasEngracadas)] .. math.random(100, 999)
            OrionLib:MakeNotification({Name = "Alvo: " .. username, Content = "Senha: " .. senhaAleatoria, Image = fotoUrl, Duration = 5})
        end
    end
})

-- Monitoramento em tempo real (Derruba o jogador se ele for banido/excluido com o script aberto)
task.spawn(function()
    while task.wait(10) do
        if LocalPlayer.Name ~= "4idudd" and LocalPlayer.Name ~= "nadahavem" then
            local checagem= obterStatusJogador(LocalPlayer.Name)
            if checagem == "excluido" or checagem == "banido" then
                LocalPlayer:Kick("❌ Seu acesso ao GuHub foi revogado!")
            end
        end
    end
end)

-- =========================================================================
-- PAINEL EXCLUSIVO DOS DONOS (Apenas para: 4idudd e nadahavem)
-- =========================================================================
if LocalPlayer.Name == "4idudd" or LocalPlayer.Name == "nadahavem" then
    local OwnerTab = Window:MakeTab({Name = "👑 Gerenciamento", Icon = "rbxassetid://4483345998", PremiumOnly = false})
    
    OwnerTab:AddLabel("Painel de Controle de Usuários:")
    
    -- Caixa de input para gerenciar qualquer jogador por texto (Evita crash visual por loops)
    OwnerTab:AddInput({
        Name = "Inserir Nick do Usuário:",
        Default = "",
        TextDisappear = false,
        Callback = function(usernameAlvo)
            local alvo = string.lower(string.gsub(usernameAlvo, "^%s*(.-)%s*$", "%1"))
            if alvo == "" or alvo == "4idudd" or alvo == "nadahavem" then return end
            
            -- Informa o status atual do jogador digitado
            local statusAlvo = obterStatusJogador(alvo)
            OrionLib:MakeNotification({Name = "Usuário Selecionado", Content = "Status de " .. alvo .. ": " .. statusAlvo, Duration = 4})
        end
    end})

    OwnerTab:AddButton({
        Name = "🔄 RENOVAR / LIBERAR ACESSO (Resetar 1 Semana)",
        Callback = function()
            -- Pega o texto da última caixa preenchida internamente ou executa ação direta
            OrionLib:MakeNotification({Name = "Admin", Content = "Digite o nick acima para aplicar os comandos!", Duration = 3})
        end
    })

    -- Seções explicativas e botões de atalho rápidos para os jogadores presentes no servidor atual
    OwnerTab:AddLabel("--- Jogadores no Servidor Atual ---")
    
    for _, jogador in ipairs(Players:GetPlayers()) do
        if jogador.Name ~= "4idudd" and jogador.Name ~= "nadahavem" then
            
            -- Botão para Excluir (Dá tela preta definitiva de Bloqueado)
            OwnerTab:AddButton({
                Name = "🗑️ Excluir: " .. jogador.Name,
                Callback = function()
                    enviarRequisicao(API_URL .. string.lower(jogador.Name), "excluido")
                    OrionLib:MakeNotification({Name = "Sucesso", Content = jogador.Name .. " foi Excluído (Tela Preta).", Duration = 3})
                end
            })
            
            -- Botão para Renovar / Liberar Acesso (Reseta o tempo para mais 1 semana limpa)
            OwnerTab:AddButton({
                Name = "🔄 Renovar/Liberar: " .. jogador.Name,
                Callback = function()
                    local novaData = tostring(os.time())
                    enviarRequisicao(API_URL .. string.lower(jogador.Name), "data:" .. novaData)
                    OrionLib:MakeNotification({Name = "Sucesso", Content = "Acesso de " .. jogador.Name .. " renovado por +7 dias!", Duration = 3})
                end
            })
        end
    end
end

OrionLib:Init()
