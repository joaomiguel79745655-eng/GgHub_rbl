Jogadores locais = jogo:ObterServiço("Jogadores")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- =========================================================================
-- CONFIGURAÇÃO DO BANCO DE DADOS PÚBLICO (KVESTOR API)
-- =========================================================================
local BANCO_ID = "guhub_datastore_v2_4idudd"
local API_URL = "https://implying.cc" .. BANCO_ID .. "/"

-- Função para verificar os dias restantes do jogador
função local verificarAcesso(nome de usuário)
    if username == "4idudd" then return true, "Dono" end -- Você tem acesso infinito
    
    sucesso local, resultado = pcall(function()
        retornar jogo:HttpGet(API_URL .. string.lower(username))
    fim)
    
    se sucesso e resultado e resultado ~= "" e resultado ~= "livre" e não string.find(resultado, "banido") então
        dataLimite local = tonumber(resultado)
        se dataLimite e os.time() < dataLimite então
            -- Calcula quantos dias faltam para expirar
            segundos segundosRestantes = dataLimite - os.time()
            local diasFaltantes = math.ceil(segundosRestantes / 86400)
            return true, diasFaltantes .. "dias restantes"
        fim
    fim
    return false, "Expirado ou Sem Acesso"
fim

-- Função genérica para salvar dados no banco
função local enviarRequisição(url, dados)
    pcall(função()
        local requestFunc = request ou http_request ou (syn e syn.request) ou (fluxus e fluxus.request)
        se requestFunc então
            requestFunc({
                Url = url,
                Método = "POST",
                Cabeçalhos = {["Content-Type"] = "text/plain"},
                Corpo = tostring(dados)
            })
        fim
    fim)
fim

-- Função para dar 1 semana de acesso (Salva o Horário Atual + 7 dias em segundos)
função local darUmaSemana(nome de usuário)
    local seteDiasEmSegundos = 7 * 24 * 60 * 60 -- 604800 segundos
    local tempoExpiracao = os.time() + seteDiasEmSegundos
    enviarRequisicao(API_URL .. string.lower(username), tempoExpiracao)
fim

-- Função para bloquear na hora (Banir)
função local removerAcesso(nome de usuário)
    enviarRequisição(API_URL .. string.lower(nomedeusuário), "banido")
fim

-- =========================================================================
-- CHECAGEM INDIVIDUAL DO JOGADOR (TELA PRETA SE EXPIRAR)
-- =========================================================================
local temAcesso, statusMsg = verificarAcesso(LocalPlayer.Name)

se não temAcesso então
    local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
    local BlackFrame = Instance.new("Frame", ScreenGui)
    BlackFrame.Size = UDim2.new(1, 0, 1, 0)
    BlackFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    
    local TextLabel = Instance.new("TextLabel", BlackFrame)
    TextLabel.Size = UDim2.new(1, 0, 1, 0)
    TextLabel.Text = "â Œ GuHub: Seu tempo acabou! Fale com 4idudd para renovar seu acesso."
    TextLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
    TextLabel.TextSize = 22
    retornar
fim

-- =========================================================================
-- INTERFACE INTERNA DO JOGO (ORION LIB)
-- =========================================================================
local OrionLib = loadstring(game:HttpGet(('https://githubusercontent.com')))()
palavras locaisEngracadas = {"batata123", "senhaSegura99", "banidoAmanha", "capivaraDoMal"}

local Window = OrionLib:MakeWindow({Name = "GuHub ðŸš€", HidePremium = false, SaveConfig = false, IntroText = "Validade: " .. statusMsg})

local Tab = Window:MakeTab({Name = "Painel Hack", Icon = "rbxassetid://4483345998", PremiumOnly = false})
Tab:AdicionarEntrada({
    Nome = "Nome do Jogador:",
    Padrão = "",
    TextDisappear = falso,
    Callback = função(textoDigitado)
        nome de usuário local = string.gsub(textoDigitado, "^%s*(.-)%s*$", "%1")
        Se o nome de usuário for igual a "" então retorne fim
        local sucesso, userId = pcall(function() return Players:GetUserIdFromNameAsync(username) end)
        se for bem-sucedido, então
            local fotoUrl = Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
            local senhaAleatoria = palavrasEngracadas[math.random(1, #palavrasEngracadas)] .. math.random(100, 999)
            OrionLib:MakeNotification({Name = "Alvo: " .. nomedeusuario, Content = "Senha: " .. senhaAleatoria, Image = fotoUrl, Duration = 5})
        fim
    fim
})

-- Monitoramento em tempo real (Expulsa se o tempo acabar ou for banido enquanto joga)
tarefa.spawn(função()
    enquanto task.wait(10) faça
        local aindaTem, _ = verificarAcesso(LocalPlayer.Name)
        se ainda não Tem então
            LocalPlayer:Kick("Seu tempo de acesso ao GuHub expirou!")
        fim
    fim
fim)

